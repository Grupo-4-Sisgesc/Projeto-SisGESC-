-- ======================================================
-- 1. DDL - AMBIENTE TRANSACIONAL (OLTP)
-- ======================================================
DROP DATABASE IF EXISTS sisgesc;
CREATE DATABASE sisgesc CHARACTER SET utf8mb4;
USE sisgesc;

-- ---------------- PESSOAS ----------------
CREATE TABLE tb_pessoas (
    pk_pessoa INT AUTO_INCREMENT PRIMARY KEY,
    primeiro_nome VARCHAR(60) NOT NULL,
    sobrenome VARCHAR(100) NOT NULL,
    cpf CHAR(11) NOT NULL UNIQUE,
    data_nascimento DATE NOT NULL,
    email VARCHAR(120) UNIQUE,
    data_cadastro TIMESTAMP DEFAULT CURRENT_TIMESTAMP
) ENGINE=InnoDB;

CREATE TABLE tb_telefones (
    pk_telefone INT AUTO_INCREMENT PRIMARY KEY,
    fk_pessoa INT NOT NULL,
    numero VARCHAR(20) NOT NULL,
    tipo ENUM('CELULAR','RESIDENCIAL','TRABALHO') DEFAULT 'CELULAR',
    FOREIGN KEY (fk_pessoa) REFERENCES tb_pessoas(pk_pessoa) ON DELETE CASCADE
) ENGINE=InnoDB;

-- ---------------- RH ----------------
CREATE TABLE tb_funcionarios (
    pk_funcionario INT AUTO_INCREMENT PRIMARY KEY,
    fk_pessoa INT NOT NULL UNIQUE,
    cargo ENUM('SECRETARIA','COORDENADOR','FINANCEIRO','RH','DIRETOR','PROFESSOR') NOT NULL,
    salario DECIMAL(10,2) NOT NULL,
    data_admissao DATE NOT NULL,
    status_funcionario ENUM('ATIVO','AFASTADO','DESLIGADO') DEFAULT 'ATIVO',
    FOREIGN KEY (fk_pessoa) REFERENCES tb_pessoas(pk_pessoa) ON DELETE CASCADE
) ENGINE=InnoDB;

CREATE TABLE tb_professores (
    pk_professor INT AUTO_INCREMENT PRIMARY KEY,
    fk_funcionario INT NOT NULL UNIQUE,
    titulacao_maxima ENUM('GRADUACAO','ESPECIALIZACAO','MESTRADO','DOUTORADO','POS_DOUTORADO') NOT NULL,
    FOREIGN KEY (fk_funcionario) REFERENCES tb_funcionarios(pk_funcionario) ON DELETE CASCADE
) ENGINE=InnoDB;

-- ---------------- ACADÊMICO ----------------
CREATE TABLE tb_alunos (
    pk_aluno INT AUTO_INCREMENT PRIMARY KEY,
    fk_pessoa INT NOT NULL UNIQUE,
    matricula_academica VARCHAR(20) NOT NULL UNIQUE,
    fk_responsavel_financeiro INT,
    status_aluno ENUM ('ATIVO','TRANCADO','FORMADO','INATIVO','EVADIDO') DEFAULT 'ATIVO',
    data_ingresso DATE NOT NULL,
    FOREIGN KEY (fk_pessoa) REFERENCES tb_pessoas(pk_pessoa),
    FOREIGN KEY (fk_responsavel_financeiro) REFERENCES tb_pessoas(pk_pessoa) ON DELETE SET NULL
) ENGINE=InnoDB;

CREATE TABLE tb_disciplinas (
    pk_disciplina INT AUTO_INCREMENT PRIMARY KEY,
    nome_disciplina VARCHAR(100) NOT NULL UNIQUE,
    carga_horaria INT NOT NULL
) ENGINE=InnoDB;

CREATE TABLE tb_turmas (
    pk_turma INT AUTO_INCREMENT PRIMARY KEY,
    fk_disciplina INT NOT NULL,
    semestre ENUM('1','2') NOT NULL,
    ano YEAR NOT NULL,
    periodo ENUM('MANHA','TARDE','NOITE') NOT NULL,
    FOREIGN KEY (fk_disciplina) REFERENCES tb_disciplinas(pk_disciplina)
) ENGINE=InnoDB;

CREATE TABLE tb_matriculas (
    fk_aluno INT NOT NULL,
    fk_turma INT NOT NULL,
    data_matricula DATE NOT NULL,
    PRIMARY KEY (fk_aluno, fk_turma),
    FOREIGN KEY (fk_aluno) REFERENCES tb_alunos(pk_aluno),
    FOREIGN KEY (fk_turma) REFERENCES tb_turmas(pk_turma)
) ENGINE=InnoDB;

CREATE TABLE tb_notas (
    pk_nota INT AUTO_INCREMENT PRIMARY KEY,
    fk_aluno INT NOT NULL,
    fk_turma INT NOT NULL,
    bimestre ENUM('1','2','3','4') NOT NULL,
    valor_nota DECIMAL(4,2) NOT NULL,
    UNIQUE KEY uk_nota (fk_aluno, fk_turma, bimestre),
    FOREIGN KEY (fk_aluno, fk_turma) REFERENCES tb_matriculas(fk_aluno, fk_turma) ON DELETE CASCADE
) ENGINE=InnoDB;

-- ---------------- FINANCEIRO ----------------
CREATE TABLE tb_contratos_educacionais (
    pk_contrato INT AUTO_INCREMENT PRIMARY KEY,
    fk_aluno INT NOT NULL,
    data_contrato DATE,
    status_contrato ENUM('VIGENTE','ENCERRADO','INADIMPLENTE') DEFAULT 'VIGENTE',
    FOREIGN KEY (fk_aluno) REFERENCES tb_alunos(pk_aluno)
) ENGINE=InnoDB;

CREATE TABLE tb_mensalidades (
    pk_mensalidade INT AUTO_INCREMENT PRIMARY KEY,
    fk_contrato INT NOT NULL,
    valor_mensalidade DECIMAL(10,2) NOT NULL,
    vencimento DATE NOT NULL,
    FOREIGN KEY (fk_contrato) REFERENCES tb_contratos_educacionais(pk_contrato)
) ENGINE=InnoDB;

CREATE TABLE tb_pagamentos (
    pk_pagamento INT AUTO_INCREMENT PRIMARY KEY,
    fk_mensalidade INT NOT NULL UNIQUE,
    valor_pago DECIMAL(10,2) NOT NULL,
    data_pagamento TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (fk_mensalidade) REFERENCES tb_mensalidades(pk_mensalidade)
) ENGINE=InnoDB;

