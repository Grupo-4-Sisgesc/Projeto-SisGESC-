-- ======================================================
-- 5. OLTP -> OLAP (ETL STAR SCHEMA)
-- ======================================================

DROP DATABASE IF EXISTS sisgesc_dw;

CREATE DATABASE sisgesc_dw;

USE sisgesc_dw;

CREATE TABLE dim_aluno (
    sk_aluno INT AUTO_INCREMENT PRIMARY KEY,
    nk_aluno INT,
    nome_completo VARCHAR(200)
);

CREATE TABLE fato_desempenho (
    fk_aluno INT,
    valor_nota DECIMAL(4,2),

    CONSTRAINT fk_fato_aluno
        FOREIGN KEY (fk_aluno)
        REFERENCES dim_aluno(sk_aluno)
);

-- ======================================================
-- PROCESSO ETL
-- ======================================================

INSERT INTO dim_aluno (nk_aluno, nome_completo)
SELECT
    a.pk_aluno,
    CONCAT(p.primeiro_nome, ' ', p.sobrenome)
FROM sisgesc.tb_alunos a
INNER JOIN sisgesc.tb_pessoas p
    ON a.fk_pessoa = p.pk_pessoa;

INSERT INTO fato_desempenho (fk_aluno, valor_nota)
SELECT
    da.sk_aluno,
    n.valor_nota
FROM sisgesc.tb_notas n
INNER JOIN dim_aluno da
    ON n.fk_aluno = da.nk_aluno;

CREATE INDEX idx_fato_aluno
ON fato_desempenho(fk_aluno);

CREATE INDEX idx_fato_valor
ON fato_desempenho(valor_nota);

-- ======================================================
-- 6. VALIDAÇÃO DE INTEGRIDADE
-- ======================================================

SELECT
    'SOMA OLTP' AS Origem,
    SUM(valor_nota) AS Total
FROM sisgesc.tb_notas

UNION ALL

SELECT
    'SOMA OLAP (DW)' AS Origem,
    SUM(valor_nota) AS Total
FROM sisgesc_dw.fato_desempenho;

-- ======================================================
-- 7. CONSULTAS E VIEWS
-- ======================================================

USE sisgesc;

-- Alunos acima da média

SELECT
    p.primeiro_nome,
    n.valor_nota
FROM tb_pessoas p
INNER JOIN tb_alunos a
    ON p.pk_pessoa = a.fk_pessoa
INNER JOIN tb_notas n
    ON a.pk_aluno = n.fk_aluno
WHERE n.valor_nota >
(
    SELECT AVG(valor_nota)
    FROM tb_notas
);

-- ======================================================
-- VIEW BOLETIM
-- ======================================================

DROP VIEW IF EXISTS vw_boletim;

CREATE VIEW vw_boletim AS
SELECT
    p.primeiro_nome,
    d.nome_disciplina,
    n.valor_nota
FROM tb_pessoas p
INNER JOIN tb_alunos a
    ON p.pk_pessoa = a.fk_pessoa
INNER JOIN tb_notas n
    ON a.pk_aluno = n.fk_aluno
INNER JOIN tb_turmas t
    ON n.fk_turma = t.pk_turma
INNER JOIN tb_disciplinas d
    ON t.fk_disciplina = d.pk_disciplina;

SELECT * FROM vw_boletim;
